# Hugo Configuration
# Copy this file to .env and fill in your values
# For local development: hugo server --environment development

# Base URL of your site (required for production builds)
# GitHub Pages: https://your-username.github.io/your-repo-name
# Netlify: https://your-site-name.netlify.app
# Cloudflare Pages: https://your-project.pages.dev
# Custom domain: https://your-domain.com
HUGO_BASEURL=https://example.com

# Author name displayed in posts and metadata
HUGO_AUTHOR=Rédaction

# Comments — Giscus (recommended, see COMMENTAIRES.md)
# Fill in the 4 values from https://giscus.app (or leave empty = no comments)
# Lightweight alternative without visitor GitHub account: CUSDIS_APP_ID from https://cusdis.com
GISCUS_REPO=
GISCUS_REPO_ID=
GISCUS_CATEGORY=
GISCUS_CATEGORY_ID=
# CUSDIS_APP_ID=
# CUSDIS_HOST=https://cusdis.com

# Audience measurement + IP — single Worker+D1 backend (see IPS.md + workers/README.md)
# Canonical, free, all platforms: deploy once, then point every site at it.
# HUGO_VISIT_API_URL=https://mon-licenciement-visits.<account>.workers.dev/api/visit
# Empty = same-origin /api/visit fallback (Pages/D1, deprecated Vercel/Netlify).
# ANONYMIZE_IP=1 -> store truncated IPs only (/24 IPv4, /48 IPv6)

# SEO: Search Console verification + IndexNow (see DEPLOY.md, SEO section)
# Verification codes (metas injected into <head>, empty = no meta):
# HUGO_GOOGLE_SITE_VERIFICATION=
# HUGO_BING_SITE_VERIFICATION=
# IndexNow (Bing/Yandex/Naver/Seznam/Yep — Google opts out):
# INDEXNOW_KEY= (generate via: npm run seo:init, file static/<key>.txt)

# Social Links
GITHUB_URL=https://github.com/your-username
# EMAIL_URL=mailto:contact@example.com

# Analytics (optional)
# GOOGLE_ANALYTICS=G-XXXXXXXXXX

# Deployment Secrets (set these in your platform's dashboard, not in .env)
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_PROJECT_NAME=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=